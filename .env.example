# Model the server proxies at /v1/model; the key never reaches the browser.
ISNAD_MODEL_API_KEY=
ISNAD_MODEL_BASE_URL=https://api.novita.ai/openai/v1
ISNAD_MODEL_NAME=zai-org/glm-5.3

# Language of human-readable API text (explanations, error messages, source names)
# when a request sends neither ?lang= nor Accept-Language: en (default) or ar.
# Statuses, error codes and references are the same in every language.
# ISNAD_DEFAULT_LOCALE=en

# Aggregate server statistics at GET /v1/stats (counts only: no quote text, no
# references). Off by default, because the API has no authentication of its own.
# ISNAD_STATS_ENABLED=1

# Optional file that keeps the statistics across restarts (flushed every 60 s and
# on shutdown). Without it, counters reset when the process restarts.
# ISNAD_STATS_PATH=/var/lib/isnad/stats.json
